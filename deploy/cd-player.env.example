# Copied to /etc/default/cd-player by install-service.sh on first install
# (never overwritten on re-install -- edit the live file directly and
# `sudo systemctl restart cd-player` to apply changes).

# Room/player name of the Sonos speaker selected at boot, as shown in the
# Sonos app. Additional speakers can be grouped in at runtime via the
# touchscreen settings screen; that selection resets to just this speaker
# on every restart.
CD_PLAYER_SPEAKER_NAME=Living Room

# This Pi's LAN IP, reachable by the Sonos speaker(s). Static for now --
# if it's not on a DHCP reservation and the Pi's IP ever changes, update
# this and restart the service.
CD_PLAYER_ADVERTISE_HOST=192.168.1.11

# Stable /dev/disk/by-id/... path to the USB optical drive (not /dev/sr0 --
# drive enumeration order isn't guaranteed). Find it with:
#   ls -la /dev/disk/by-id/ | grep -i usb
CD_PLAYER_DEVICE_PATH=/dev/disk/by-id/usb-HL-DT-ST_DVDRAM_GS40N_4B5956323150413038353520-0:0
